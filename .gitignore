# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
*.local

# FinSight runtime data (regenerated by processing)
data/uploads/
data/renders/
data/cache/
data/exports/
data/*.db
data/*.db-shm
data/*.db-wal

data/perf/
data/reports/

# Benchmark documents are kept; their ground-truth keys are version controlled.
!data/benchmark/
!data/benchmark/*.truth.json

# Evaluation corpus. Only the manifests are version controlled: they list every
# document's source URL and sha256, so the PDFs can be fetched again and
# verified byte for byte. The PDFs themselves are third-party filings (170 MB),
# and the run records, scores, dashboards and logs (~600 MB) are regenerated by
# scripts/corpus_run.py and scripts/corpus_score.py.
data/corpus/*
!data/corpus/manifest.json
!data/corpus/evaluation_manifest.json

# Debugging scratch work
scratch/

# Local configuration
.env

# Editors / OS / local agent config
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# Generated image-only test fixture (rebuild with scripts/make_image_only_pdf.py)
data/benchmark/RIL_Q1_FY27_IMAGE_ONLY.pdf
