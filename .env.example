# FinSight configuration. Copy to .env and edit as needed.
# Every value below is optional -- the defaults are what the acceptance run used.

# --- storage & database -------------------------------------------------
# FINSIGHT_DATABASE_URL=sqlite:///./data/finsight.db
# PostgreSQL works without schema changes:
# FINSIGHT_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/finsight

# --- rendering ----------------------------------------------------------
# Higher DPI improves OCR on small table text but costs time and memory.
# FINSIGHT_RENDER_DPI=200

# --- OCR ----------------------------------------------------------------
# FINSIGHT_OCR_ENGINE=rapidocr
# FINSIGHT_OCR_DET_LIMIT_SIDE_LEN=1600
# FINSIGHT_OCR_TEXT_SCORE=0.35

# --- validation tolerances ---------------------------------------------
# Absolute percentage points allowed between a reported and a recomputed figure.
# FINSIGHT_GROWTH_TOLERANCE_PCT=0.6
# FINSIGHT_MARGIN_TOLERANCE_PCT=0.35
# FINSIGHT_TOTAL_TOLERANCE_REL=0.02

# --- confidence ---------------------------------------------------------
# FINSIGHT_CONFIDENCE_HIGH=0.85
# FINSIGHT_CONFIDENCE_MEDIUM=0.65
# FINSIGHT_REVIEW_THRESHOLD=0.65

# --- concurrency --------------------------------------------------------
# FINSIGHT_WORKER_THREADS=2
# FINSIGHT_PAGE_WORKERS=2

# --- optional local LLM (summarisation only, never fact extraction) ------
# Requires Ollama running locally. The pipeline is fully functional without it.
# FINSIGHT_LLM_ENABLED=false
# FINSIGHT_LLM_PROVIDER=ollama
# FINSIGHT_LLM_BASE_URL=http://127.0.0.1:11434
# FINSIGHT_LLM_MODEL=qwen3:4b
